# football-data.org (https://www.football-data.org/client/register), gratuit.
# Source des 5 grands championnats européens.
FOOTBALL_DATA_KEY=
# Live-score API (https://livescore-api.com). Source de la Botola Pro.
LIVESCORE_API_KEY=
LIVESCORE_API_SECRET=
# API-Football (https://dashboard.api-football.com). Plus utilisé pour l'instant.
API_FOOTBALL_KEY=
# Optionnel : année de début d'une autre saison à afficher (2024 = saison 2024-25).
# Laisser vide pour suivre la saison en cours.
FOOTBALL_SEASON=
# Base Postgres des articles (Neon via Vercel > Storage). Sans elle, seuls les
# flux RSS par défaut s'affichent et la page /fr/admin ne peut rien ajouter.
# Sur Vercel elle s'appelle MF_DATABASE_URL (préfixe « MF » de l'intégration Neon).
DATABASE_URL=
# Mot de passe de la page d'administration des articles (/fr/admin).
ADMIN_PASSWORD=
# Google AdSense (publicité). Laisser vide tant que le compte n'est pas validé :
# aucun emplacement ne s'affiche. ID éditeur « ca-pub-… » (AdSense > Compte),
# puis un « bloc d'annonces display » par emplacement (AdSense > Annonces > Par bloc d'annonces).
ADSENSE_CLIENT=
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_SIDEBAR=
# 1 = affiche des cadres gris « Publicité » à la place des annonces, pour vérifier la mise en page.
ADS_PREVIEW=
